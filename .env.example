# ──────────────────────────────────────────────────────────────────
# AETHER Backend – Ortam Değişkenleri Şablonu
# 1. Bu dosyayı .env olarak kopyala:  cp .env.example .env
# 2. Tüm değerleri gerçek değerlerle değiştir
# 3. .env dosyasını asla Git'e commit ETME!
# ──────────────────────────────────────────────────────────────────

# PostgreSQL şifresi
DB_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZ

# Redis şifresi
REDIS_PASSWORD=BURAYA_REDIS_SIFRESI_YAZ

# JWT imzalama anahtarı (en az 256-bit, base64 encoded)
# Yeni anahtar üretmek için:  openssl rand -base64 32
JWT_SECRET=BURAYA_OPENSSL_CIKTISINI_YAZ

JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_REMEMBER_ME_REFRESH_EXPIRATION=2592000000

# Şifreleme anahtarı (AES-256, base64 encoded)
# Yeni anahtar üretmek için:  openssl rand -base64 32
ENCRYPTION_SECRET_KEY=BURAYA_OPENSSL_CIKTISINI_YAZ
